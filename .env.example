# Copiar como .env y completar. El archivo .env no se versiona.
#
# Clave criptográfica del proyecto. En producción es obligatoria: el proyecto
# se niega a arrancar con la clave de desarrollo cuando DEBUG está apagado.
# Generar una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Apagar en cualquier entorno que no sea el computador del desarrollador.
DJANGO_DEBUG=True

# Dominios autorizados, separados por coma.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

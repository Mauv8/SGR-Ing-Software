# Copiar como .env y completar. El archivo .env no se versiona.
#
# Clave criptográfica. En producción es obligatoria. Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Apagar en cualquier entorno que no sea el computador del desarrollador.
DJANGO_DEBUG=True

# Dominios autorizados, separados por coma.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (si se deja POSTGRES_DB vacío se usa SQLite).
POSTGRES_DB=sgr
POSTGRES_USER=sgr
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# En AWS RDS usar: require
POSTGRES_SSLMODE=prefer
